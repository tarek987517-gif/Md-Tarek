# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Initial Super Admin Configuration (Server-side only)
SUPER_ADMIN_EMAIL="tarek987517@gmail.com"
SUPER_ADMIN_PASSWORD="SecurePassword#2026!"
SUPER_ADMIN_NAME="তারেক রহমান"

# Initial Reporter Configuration (Server-side only)
REPORTER_EMAIL="reporter@haortvhd.com"
REPORTER_PASSWORD="ReporterPassword#2026!"
REPORTER_NAME="মেরাজ বিন আসকর"

# JWT / Session Security Secret
JWT_SECRET="haor-tv-secure-salt-jwt-token-2026-production"

# Netlify Deployment Configuration (Optional for automated deploy via API)
NETLIFY_AUTH_TOKEN=""
NETLIFY_SITE_ID=""
